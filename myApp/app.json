{
  "expo": {
    "name": "bassh",
    "slug": "bassh",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bassh",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000000",
    "newArchEnabled": true,
    "extra": {
      "MAPBOX_TOKEN": "${EXPO_PUBLIC_MAPBOX_TOKEN}",
      "RAZORPAY_KEY_ID": "${EXPO_PUBLIC_RAZORPAY_KEY_ID}",
      "router": {},
      "eas": {
        "projectId": "53f809e9-7072-48e1-bcbc-8be389eda29b"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.harshsehra.bassh",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs access to your location to show nearby events on the map.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app needs access to your location to show nearby events on the map.",
        "NSCameraUsageDescription": "This app needs camera access to scan QR codes for entry verification."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "backgroundImage": "./assets/images/icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.harshsehra.bassh",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@rnmapbox/maps",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "This app needs access to your location to show nearby events on the map."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Bassh to access your camera to scan QR codes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "bassh404"
  }
}
