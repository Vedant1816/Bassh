{
  "expo": {
    "name": "bassh",
    "slug": "bassh",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    
    "scheme": "bassh",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "extra": {
      "MAPBOX_TOKEN": "${EXPO_PUBLIC_MAPBOX_TOKEN}",
      "RAZORPAY_KEY_ID": "${EXPO_PUBLIC_RAZORPAY_KEY_ID}"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.harshsehra.bassh",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs access to your location to show nearby events on the map.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "This app needs access to your location to show nearby events on the map.",
        "NSCameraUsageDescription": "This app needs camera access to scan QR codes for entry verification."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.harshsehra.bassh",
      "usesCleartextTraffic": true,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@rnmapbox/maps",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "This app needs access to your location to show nearby events on the map."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Bassh to access your camera to scan QR codes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
